---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Gracias por reservar | Centre Sanitari Villaquet"
  description="Tu solicitud de cita se ha enviado correctamente. Gracias por confiar en Centre Sanitari Villaquet."
>
  <main>
    <section class="section thanks-page">
      <div class="container thanks-page__content">
        <span class="section__tag">Gracias</span>
        <h1 class="section__title">Tu solicitud de cita ha sido enviada</h1>
        <p class="section__desc">
          Gracias por confiar en Centre Sanitari Villaquet. Hemos recibido tu petición y nuestro equipo
          revisará la información para confirmar la cita lo antes posible.
        </p>

        <div class="thanks-page__actions">
          <a href="/" class="btn btn--primary">Volver al inicio</a>
          <a href="/reservar-cita" class="btn btn--outline">Reservar otra cita</a>
        </div>

        <div class="thanks-page__info">
          <p><strong>¿Necesitas ayuda urgente?</strong> Puedes contactar con nosotros en el teléfono 877 643 360.</p>
          <p><strong>Email:</strong> info@villaquet.com</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
