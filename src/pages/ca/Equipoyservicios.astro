---
import Layout from '../../layouts/Layout.astro';
import { especialidades, profesionales } from '../../data/especialidades';
import { especialitatsCa, professionalsCa } from '../../data/catala';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;
const especialitats = especialitatsCa as Record<string, string>;
const professionals = professionalsCa as Record<string, { role: string; bio: string }>;

const profesionalesAgrupados = especialidades
  .map((especialidad) => ({
    ...especialidad,
    profesionales: profesionales.filter((profesional) => profesional.especialidad === especialidad.slug),
  }))
  .filter((especialidad) => especialidad.profesionales.length > 0);
---

<Layout
  title="Equip professional | Centre Sanitari Villaquet"
  description="Coneix el nostre equip professional i l’especialitat associada a cada especialista de Centre Sanitari Villaquet."
  keywords="equip professional Calafell, especialistes Calafell, professionals mèdics Calafell, ginecologia Calafell, dermatologia Calafell"
>
  <main>
    <section class="specialties-page__hero">
      <div class="container">
        <span class="section__tag">Equip professional</span>
        <h1 class="section__title">Especialistes que t’acompanyen en cada etapa de la teva salut</h1>
        <p class="section__desc">Cada professional està vinculat a una especialitat per oferir una atenció més precisa, personalitzada i coordinada.</p>
      </div>
    </section>

    <section class="team section" id="equipo">
      <div class="container">
        {profesionalesAgrupados.map((grupo) => (
          <div class="team__specialty-group" style="margin-bottom: 3rem;">
            <div class="section__header" style="margin-bottom: 1.5rem;">
              <span class="section__tag">{especialitats[grupo.slug] || grupo.title}</span>
              <h2 class="section__title">Professionals de {especialitats[grupo.slug] || grupo.title}</h2>
            </div>

            <div class="team__grid">
              {grupo.profesionales.map((profesional) => (
                <article class="doctor-card" id={profesional.id}>
                  <div class="doctor-card__header">
                    <div class="doctor-card__avatar">
                      <img src={profesional.image} alt={profesional.nombre} />
                    </div>
                    <div>
                      <h3>{profesional.nombre}</h3>
                      <p class="doctor-card__role">{professionals[profesional.id]?.role || profesional.role}</p>
                    </div>
                  </div>
                  <p class="doctor-card__specialty">Especialitat: {especialitats[grupo.slug] || grupo.title}</p>
                  <p class="doctor-card__bio">{professionals[profesional.id]?.bio || profesional.bio}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="contact__cta">
          <h3>Necessites una visita o més informació?</h3>
          <p>Oferim atenció propera, coordinació assistencial i processos senzills perquè puguis reservar la teva visita en pocs minuts.</p>
          <div class="contact__cta-actions">
            <a href={`${localeBase}reservar-cita`} class="btn btn--primary">Reservar visita</a>
            <a href={`${localeBase}servicios`} class="btn btn--outline">Veure especialitats</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
