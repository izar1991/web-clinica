---
import Layout from '../../layouts/Layout.astro';
import { especialidades } from '../../data/especialidades';
import { especialitatsCa } from '../../data/catala';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;
const especialitats = especialitatsCa as Record<string, string>;
---

<Layout
  title="Serveis mèdics a Calafell | Centre Sanitari Villaquet"
  description="Descobreix la cartera de serveis mèdics a Calafell: medicina general, ginecologia, dermatologia, psicologia, fisioteràpia, podologia i diagnòstic per la imatge."
  keywords="serveis mèdics Calafell, centre mèdic Calafell, medicina general Calafell, ginecologia Calafell, dermatologia Calafell, fisioteràpia Calafell, podologia Calafell"
>
  <main>
    <section class="specialties-page__hero">
      <div class="container">
        <span class="section__tag">Especialitats</span>
        <h1 class="section__title">Serveis mèdics per a totes les teves necessitats</h1>
        <p class="section__desc">Consulta la nostra cartera d’especialitats i troba l’atenció més adequada per a tu i la teva família.</p>
      </div>
    </section>

    <section class="section">
      <div class="container specialties-page__grid">
        {especialidades.map((especialidad) => (
          <article class="specialty-page-card">
            <div class="specialty-page-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2v20M2 12h20"/></svg>
            </div>
            <h2>{especialitats[especialidad.slug] || especialidad.title}</h2>
            <p>Atenció especialitzada, propera i centrada en el teu benestar.</p>
            <a href={`${localeBase}servicios/${especialidad.slug}`} class="btn btn--outline">Veure’n més</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
