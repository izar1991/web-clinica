---
import Layout from '../../layouts/Layout.astro';
import { especialidades } from '../../data/especialidades';
import { especialitatsCa } from '../../data/catala';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;
const especialitats = especialitatsCa as Record<string, string>;
---

<Layout
  title="Serveis mèdics a Calafell | Centre Sanitari Villaquet"
  description="Descobreix la cartera de serveis mèdics a Calafell: medicina general, ginecologia, dermatologia, psicologia, fisioteràpia, podologia i diagnòstic per la imatge."
  keywords="serveis mèdics Calafell, centre mèdic Calafell, medicina general Calafell, ginecologia Calafell, dermatologia Calafell, fisioteràpia Calafell, podologia Calafell"
>
  <main>
    <section class="specialties-page__hero">
      <div class="container">
        <span class="section__tag">Especialitats</span>
        <h1 class="section__title">Serveis mèdics per a totes les teves necessitats</h1>
        <p class="section__desc">Consulta la nostra cartera d’especialitats i troba l’atenció més adequada per a tu i la teva família.</p>
      </div>
    </section>

    <section class="section">
      <div class="container specialties-page__grid">
        {especialidades.map((especialidad) => (
          <article class="specialty-page-card">
            <div class="specialty-page-card__icon">
              <span class={`medical-icon-${especialidad.slug === 'medicina-general' ? 'i-family-practice' : especialidad.slug === 'ginecologia-obstetricia' ? 'i-womens-health' : especialidad.slug === 'dermatologia' ? 'i-dermatology' : especialidad.slug === 'aparato-digestivo' ? 'i-internal-medicine' : especialidad.slug === 'psicologia' ? 'i-mental-health' : especialidad.slug === 'fisioterapia' ? 'i-physical-therapy' : especialidad.slug === 'enfermeria' ? 'i-care-staff-area' : especialidad.slug === 'diagnostico-por-imagen' ? 'i-radiology' : ''}`} aria-hidden="true"></span>
              {especialidad.slug === 'podologia' && <img src={`${base}images/podologia-pie.svg`} alt="" aria-hidden="true" />}
                    {especialidad.slug === 'medicina-general' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/></svg>}
                    {especialidad.slug === 'ginecologia-obstetricia' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M12 12v9M8 17h8M9 21h6"/></svg>}
                    {especialidad.slug === 'dermatologia' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h16v14H4z"/><path d="M4 9c3-2 5 2 8 0s5 2 8 0M4 13c3-2 5 2 8 0s5 2 8 0"/><path d="M13 5c0-2 1-3 2-3M15 5c0-2.5 1.5-3.5 2.5-4"/></svg>}
              {especialidad.slug === 'aparato-digestivo' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 3v5a4 4 0 0 0 4 4 4 4 0 0 1 4 4v5"/><path d="M8 3h3M16 21h-3a4 4 0 0 1-4-4v-1a3 3 0 0 0-3-3H4"/></svg>}
            </div>
            <h2>{especialitats[especialidad.slug] || especialidad.title}</h2>
            <p>Atenció especialitzada, propera i centrada en el teu benestar.</p>
            <a href={`${localeBase}servicios/${especialidad.slug}`} class="btn btn--outline">Veure’n més</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
