---
import Layout from '../../layouts/Layout.astro';

const iframeSrc = 'https://citaonline.dricloud.net/?URL=dricloud_centresanitarivillaquet_21026811';
---

<Layout title="Reservar visita | Centre Sanitari Villaquet" description="Reserva la teva visita a Centre Sanitari Villaquet. Sol·licita una consulta mèdica a Calafell i contactarem amb tu tan aviat com sigui possible.">
  <main>
    <section class="reservation-page__hero">
      <div class="container reservation-page__intro">
        <span class="section__tag">Reserva la teva visita</span>
        <h1 class="section__title">Sol·licita una consulta amb nosaltres</h1>
        <p class="section__desc">Omple el formulari i contactarem amb tu per confirmar la visita o indicar-te el pas següent segons l’especialitat que necessitis.</p>
      </div>
    </section>

    <section class="container reservation-page__grid">
      <div class="reservation-page__notice" aria-label="Informació de reserva">
        <p><strong>Com funciona?</strong> Selecciona l’especialitat i la data disponible, confirma la sol·licitud des del mòdul en línia i rebràs la validació de la visita en l’horari indicat.</p>
      </div>

      <div class="reservation-widget">
        <div class="reservation-widget__header">
          <span class="section__tag">Visita en línia</span>
          <h2>Reserva la teva visita amb el nostre sistema</h2>
        </div>

        <div class="reservation-widget__wrapper">
          <iframe
            id="ifrModuloCitaonlineVisualizacion"
            title="Reserva en línia Centre Sanitari Villaquet"
            src={iframeSrc}
            frameborder="0"
            scrolling="auto"
            width="100%"
            height="600"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="reservation-page__help">
        <h3>Necessites ajuda?</h3>
        <p>Pots parlar directament amb nosaltres per resoldre dubtes sobre horaris, serveis, assegurances o cobertura.</p>
        <div class="reservation-page__actions">
          <a href="tel:877643360" class="btn btn--primary">877 643 360</a>
          <a href="mailto:info@villaquet.com" class="btn btn--outline">info@villaquet.com</a>
        </div>
      </div>
    </section>

    <script is:inline>
      window.addEventListener('message', function (event) {
        if (event.origin !== 'https://citaonline.dricloud.net') return;

        const iframe = document.getElementById('ifrModuloCitaonlineVisualizacion');
        if (!iframe) return;

        const heightIframe = Number(event.data) || 300;
        iframe.height = String(heightIframe);
      });
    </script>
  </main>
</Layout>
