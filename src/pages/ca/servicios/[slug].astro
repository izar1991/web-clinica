---
import Layout from '../../../layouts/Layout.astro';
import { contenidoEspecialidades, especialidades, profesionales } from '../../../data/especialidades';
import { contingutEspecialitatsCa, professionalsCa } from '../../../data/catala';

export async function getStaticPaths() {
  return Object.entries(contingutEspecialitatsCa).map(([slug, data]) => ({
    params: { slug },
    props: { data: { ...data, image: contenidoEspecialidades[slug as keyof typeof contenidoEspecialidades].image } },
  }));
}

const { slug } = Astro.params;
const { data } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;
const profesionalesEspecialidad = profesionales.filter((profesional) => profesional.especialidad === slug);
const professionals = professionalsCa as Record<string, { role: string; bio: string }>;
---

<Layout
  title={`${data.title} | Centre Sanitari Villaquet`}
  description={`${data.intro} Consulta el nostre centre mèdic a Calafell i reserva la teva visita.`}
  keywords={`${data.title}, ${data.title.toLowerCase()} Calafell, centre mèdic Calafell`}
>
  <main>
    <section class="specialty-page__hero">
      <div class="container">
        <span class="section__tag">Especialitat</span>
        <h1 class="section__title">{data.title}</h1>
        <p class="section__subtitle">{data.subtitle}</p>
      </div>
    </section>

    <section class="section">
      <div class="container specialty-page__grid">
        <div class="specialty-page__content">
          <p>{data.intro}</p>

          <div class="specialty-page__media">
            <img src={data.image} alt={data.title} />
          </div>

          <div class="specialty-page__highlights">
            {data.highlights.map(([title, text]) => (
              <div class="specialty-page__highlight">
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            ))}
          </div>

          <ul class="specialty-page__list">
            {data.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <div class="specialty-page__actions">
            <a href={`${localeBase}servicios`} class="btn btn--outline">Veure totes les especialitats</a>
          </div>
        </div>

        <aside class="specialty-page__card">
          <h3>Necessites una valoració?</h3>
          <p>Contacte directe amb el nostre centre per resoldre dubtes i programar la primera visita.</p>
          <div class="specialty-page__contact">
            <a href={`${localeBase}reservar-cita`} class="btn btn--primary btn--full">{data.cta}</a>
            <a href="tel:877643360">877 643 360</a>
            <a href="mailto:info@villaquet.com">info@villaquet.com</a>
          </div>
          <div class="specialty-page__aside-image">
            <img src={data.image} alt={`Atenció de ${data.title}`} />
          </div>
        </aside>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Professionals</span>
          <h2 class="section__title">Especialistes de {data.title}</h2>
        </div>

        <div class="team__grid">
          {profesionalesEspecialidad.map((profesional) => (
            <article class="doctor-card">
              <div class="doctor-card__header">
                <div class="doctor-card__avatar">
                  <img src={profesional.image} alt={profesional.nombre} />
                </div>
                <div>
                  <h3>{profesional.nombre}</h3>
                  <p class="doctor-card__role">{professionals[profesional.id]?.role || profesional.role}</p>
                </div>
              </div>
              <p class="doctor-card__bio">{professionals[profesional.id]?.bio || profesional.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
