---
import Layout from '../../layouts/Layout.astro';
import { especialidades, profesionales } from '../../data/especialidades';
import { especialitatsCa, professionalsCa } from '../../data/catala';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;
const especialitats = especialitatsCa as Record<string, string>;
const professionals = professionalsCa as Record<string, { role: string; bio: string }>;

const serviceContent: Record<string, { title: string; description: string }> = {
  'medicina-general': {
    title: 'Medicina general',
    description: 'Atenció primària, urgències i certificats mèdics per a tota la família.',
  },
  'ginecologia-obstetricia': {
    title: 'Ginecologia i obstetrícia',
    description: 'Salut femenina integral amb seguiment personalitzat i atenció propera.',
  },
  dermatologia: {
    title: 'Dermatologia',
    description: 'Diagnòstic i tractament de patologies cutànies amb enfocament preventiu.',
  },
  psicologia: {
    title: 'Psicologia',
    description: 'Acompanyament emocional i terapèutic per a adults, famílies i adolescents.',
  },
  fisioterapia: {
    title: 'Fisioteràpia',
    description: 'Recuperació funcional, mobilitat i prevenció de lesions.',
  },
  podologia: {
    title: 'Podologia',
    description: 'Diagnòstic i tractament del peu per millorar la mobilitat i el confort.',
  },
  enfermeria: {
    title: 'Infermeria',
    description: 'Extraccions, seguiment clínic i coordinació assistencial.',
  },
  'diagnostico-por-imagen': {
    title: 'Diagnòstic per la imatge',
    description: 'Tecnologia avançada per a un diagnòstic precís, àgil i segur.',
  },
};
---

<Layout
  title="Centre mèdic a Calafell | Centre Sanitari Villaquet"
  description="Centre mèdic a Calafell amb medicina general, ginecologia, dermatologia, psicologia, fisioteràpia, podologia i diagnòstic per la imatge."
  keywords="centre mèdic Calafell, medicina general Calafell, ginecologia Calafell, dermatologia Calafell, fisioteràpia Calafell, podologia Calafell, psicologia Calafell"
>
  <main>
    <section class="hero" id="inicio">
      <div class="hero__bg"></div>
      <div class="container hero__grid">
        <div class="hero__content">
          <div class="hero__content-panel">
            <p class="hero__tag">Centre Sanitari Villaquet · Calafell</p>
            <h1 class="hero__title">El teu centre de confiança a <em>Calafell</em></h1>
            <p class="hero__subtitle">Un centre mèdic d’excel·lència i proximitat. Professionals amb una sòlida trajectòria, tecnologia d’avantguarda i atenció personalitzada.</p>

            <div class="hero__cta-group">
              <a href={`${localeBase}reservar-cita`} class="btn btn--primary btn--icon btn--hero-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 7V5a4 4 0 1 1 8 0v2"/><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M12 12v4M10 14h4"/></svg>
                Reservar visita
              </a>
            </div>

            <div class="hero__secondary-actions">
              <a href={`${localeBase}#servicios`} class="btn btn--outline btn--icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
                Especialitats
              </a>
              <a href={`${localeBase}#mutuas`} class="btn btn--outline btn--icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-8-4.35-8-10a4 4 0 0 1 7-2.65A4 4 0 0 1 20 11c0 5.65-8 10-8 10Z"/><path d="M12 9v3M9.5 11.5h5"/></svg>
                Mútues
              </a>
            </div>

            <div class="hero__stats" aria-label="Dades del centre">
              <div class="hero__stat">
                <strong>8:00–20:00</strong>
                <span>Horari d’atenció</span>
              </div>
              <div class="hero__stat">
                <strong>+10</strong>
                <span>Especialitats</span>
              </div>
              <div class="hero__stat">
                <strong>Calafell</strong>
                <span>Centre mèdic local</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="why section" id="nosotros">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Per què escollir-nos</span>
          <h2 class="section__title">Qualitat, rapidesa i atenció propera</h2>
          <p class="section__desc">Professionals amb una sòlida trajectòria i reputació, compromesos amb el teu benestar.</p>
        </div>
        <div class="why__grid">
          <article class="why-card">
            <div class="why-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Professionals altament qualificats</h3>
            <p>Equip amb una sòlida trajectòria clínica i àmplia experiència en diverses especialitats mèdiques i sanitàries. Atenció propera, rigorosa i personalitzada.</p>
          </article>
          <article class="why-card">
            <div class="why-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <h3>Instal·lacions capdavanteres</h3>
            <p>Tecnologia d’última generació: ecògrafs, raigs X, electrocardiògrafs i cardiotocògrafs. Ressonàncies magnètiques i TAC en centres col·laboradors.</p>
          </article>
          <article class="why-card">
            <div class="why-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <h3>Salut integral</h3>
            <p>Fisioteràpia, medicina estètica avançada i podologia amb instrumental d’alta qualitat. Enfocament professional orientat al benestar i la prevenció.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="services section section--alt" id="servicios">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">La nostra cartera de serveis</span>
          <h2 class="section__title">Atenció integral i multidisciplinària</h2>
          <p class="section__desc">Àmplia cartera d’especialitats mèdiques i serveis complementaris per a una atenció completa, àgil i de màxima qualitat.</p>
        </div>
        <div class="services__grid">
          {especialidades.map((especialidad) => (
            <a href={`${localeBase}servicios/${especialidad.slug}`} class="service-card service-card--link" aria-label={`Anar a ${especialitats[especialidad.slug] || especialidad.title}`}>
              <div class="service-card__icon">
                {especialidad.slug === 'medicina-general' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                )}
                {especialidad.slug === 'ginecologia-obstetricia' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                )}
                {especialidad.slug === 'dermatologia' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                )}
                {especialidad.slug === 'psicologia' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a8 8 0 0 0-8 8c0 6 8 12 8 12s8-6 8-12a8 8 0 0 0-8-8Z"/></svg>
                )}
                {especialidad.slug === 'fisioterapia' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
                )}
                {especialidad.slug === 'podologia' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                )}
                {especialidad.slug === 'enfermeria' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                )}
                {especialidad.slug === 'diagnostico-por-imagen' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                )}
              </div>
              <h3>{serviceContent[especialidad.slug]?.title || especialitats[especialidad.slug] || especialidad.title}</h3>
              <p>{serviceContent[especialidad.slug]?.description || 'Descobreix més sobre aquesta especialitat.'}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="team section" id="equipo">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Equip mèdic</span>
          <h2 class="section__title">Un equip professional de la millor qualitat</h2>
          <p class="section__desc">Especialistes amb àmplia trajectòria, formació continuada i vocació assistencial.</p>
        </div>
        <div class="team__grid">
          {profesionales.map((profesional) => {
            const especialidad = especialidades.find((item) => item.slug === profesional.especialidad);
            const nombreEspecialidad = especialitats[profesional.especialidad] || especialidad?.title || profesional.role;

            return (
              <a href={`${localeBase}Equipoyservicios#${profesional.id}`} class="doctor-card doctor-card--link" aria-label={`Anar al perfil de ${profesional.nombre}`}>
                <div class="doctor-card__header">
                  <div class="doctor-card__avatar">
                    <img src={profesional.image} alt={profesional.nombre} />
                  </div>
                  <div>
                    <h3>{profesional.nombre}</h3>
                    <p class="doctor-card__role">{nombreEspecialidad}</p>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="tech section section--alt" id="tecnologia">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">La millor tecnologia</span>
          <h2 class="section__title">Equips d’ajuda diagnòstica</h2>
          <p class="section__desc">Tecnologia d’última generació per a un diagnòstic precís, àgil i de màxima qualitat.</p>
        </div>
        <div class="tech__grid">
          <article class="tech-card">
            <div class="tech-card__label">Ecografia</div>
            <h3>CHISON QBit 7</h3>
            <p>Ecògraf Doppler color d’última generació amb alta definició i una precisió diagnòstica excel·lent. Ideal per a ginecologia, obstetrícia, ecografia abdominal, vascular, musculoesquelètica, urològica, pediàtrica i cardiològica.</p>
            <ul class="tech-card__features">
              <li>Ecografia 4D i elastografia</li>
              <li>Alta qualitat Doppler</li>
              <li>Procediments guiats</li>
            </ul>
          </article>
          <article class="tech-card">
            <div class="tech-card__label">Radiologia</div>
            <h3>Sistema Universal Vertix</h3>
            <p>Sala de radiologia convencional digitalitzada amb imatges d’alta qualitat i màxima precisió diagnòstica. Generador trifàsic d’alta freqüència i digitalització CR.</p>
            <ul class="tech-card__features">
              <li>Radiologia general i traumatologia</li>
              <li>Tòrax, extremitats i abdomen</li>
              <li>Diagnòstic àgil i segur</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="mutuas section" id="mutuas">
      <div class="container mutuas__inner">
        <div class="section__header">
          <span class="section__tag">Mútues col·laboradores</span>
          <h2 class="section__title">Cobertura d’assegurances</h2>
        </div>
        <div class="mutuas__coming">
          <div class="mutuas__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
          </div>
          <h3>Properament, noves col·laboracions</h3>
          <p>Estigues atent a les novetats. Estem ampliant la nostra xarxa de mútues i assegurances col·laboradores.</p>
          <a href={`${localeBase}reservar-cita`} class="btn btn--outline">Consultar la cobertura</a>
        </div>
      </div>
    </section>

    <section class="club section section--dark" id="club">
      <div class="container club__wrapper">
        <div class="club__header">
          <span class="section__tag section__tag--light">Club CSV</span>
          <h2 class="section__title section__title--light">Uneix-te al nostre club i gaudeix d’avantatges exclusius</h2>
          <p>Dissenyat per cuidar la teva salut i la de la teva família amb beneficis preferents, descomptes i accés a serveis d’alt valor.</p>
        </div>

        <div class="club__plans">
          <article class="club__plan club__plan--featured" id="club-plan-general">
            <div class="club__plan-head">
              <div class="club__plan-icon" aria-hidden="true">👤</div>
              <span class="club__plan-badge">General</span>
            </div>
            <h3>Club CSV General</h3>
            <p class="club__plan-audience">Ideal per a adults i famílies que busquen salut, prevenció i atenció completa.</p>
            <div class="club__plan-price">
              <span>Desde 35 € / mes</span>
            </div>
            <ul class="club__plan-list">
              <li>Medicina general</li><li>Infermeria</li><li>Analítica general completa</li><li>Revisió ginecològica anual</li><li>Fisioteràpia (5 sessions)</li><li>Podologia (quiropòdia)</li>
            </ul>
            <a href={`${localeBase}ClubCSV#general`} class="btn btn--light">Veure el detall complet</a>
          </article>

          <article class="club__plan club__plan--sport" id="club-plan-sport">
            <div class="club__plan-head">
              <div class="club__plan-icon" aria-hidden="true">⚡</div>
              <span class="club__plan-badge club__plan-badge--soft">Sport</span>
            </div>
            <h3>Club CSV Sport</h3>
            <p class="club__plan-audience">Pensat per a persones actives i esportistes que volen rendiment i recuperació.</p>
            <div class="club__plan-price">
              <span>Desde 40 € / mes</span>
            </div>
            <ul class="club__plan-list">
              <li>Medicina general</li><li>Infermeria</li><li>Analítica “Sport” completa</li><li>Fisioteràpia (10 sessions)</li><li>Podologia (quiropòdia + estudi biomecànic)</li>
            </ul>
            <a href={`${localeBase}ClubCSV#sport`} class="btn btn--outline btn--outline-light">Veure el detall complet</a>
          </article>

          <article class="club__plan club__plan--senior" id="club-plan-senior">
            <div class="club__plan-head">
              <div class="club__plan-icon" aria-hidden="true">🌿</div>
              <span class="club__plan-badge club__plan-badge--warm">Sènior</span>
            </div>
            <h3>Club CSV Senior (+60)</h3>
            <p class="club__plan-audience">Dissenyat per a majors de 60 anys amb atenció preventiva i benestar integral.</p>
            <div class="club__plan-price">
              <span>Desde 35 € / mes</span>
            </div>
            <ul class="club__plan-list">
              <li>Medicina general</li><li>Infermeria</li><li>Analítica sènior completa</li><li>Fisioteràpia (5 sessions)</li><li>Podologia (2 quiropòdies)</li>
            </ul>
            <a href={`${localeBase}ClubCSV#senior`} class="btn btn--outline btn--outline-light">Veure el detall complet</a>
          </article>
        </div>

        <p class="club__note">Tres modalitats adaptades a cada etapa. Consulta les cobertures, analítiques, sessions i condicions detallades de cada targeta a la pàgina del Club CSV.</p>
        <div class="club__actions">
          <a href={`${localeBase}ClubCSV`} class="btn btn--outline btn--outline-light">Veure totes les modalitats</a>
        </div>
      </div>
    </section>

    <section class="contact section" id="contacto">
      <div class="container contact__grid">
        <div class="contact__info">
          <span class="section__tag">Contacte</span>
          <h2 class="section__title">Som aquí per ajudar-te</h2>

          <div class="contact__item">
            <div class="contact__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <strong>Adreça</strong>
              <p>Carrer Molí del Blanquet, 24, baixos<br />El Vilarenc, 43820 Calafell, Tarragona</p>
            </div>
          </div>

          <div class="contact__item">
            <div class="contact__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
            </div>
            <div>
              <strong>Telèfon</strong>
              <p><a href="tel:877643360">877 643 360</a></p>
            </div>
          </div>

          <div class="contact__item">
            <div class="contact__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <strong>Email</strong>
              <p><a href="mailto:info@villaquet.com">info@villaquet.com</a></p>
            </div>
          </div>

          <div class="contact__item">
            <div class="contact__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong>Horari</strong>
              <p>Dilluns – Divendres: 8:00–13:00 / 15:00–20:00</p>
            </div>
          </div>

          <div class="contact__map">
            <iframe title="Ubicación Centre Sanitari Villaquet" src="https://maps.google.com/maps?q=Carrer+Mol%C3%AD+del+Blanquet+24+Calafell&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>

        <div class="contact__cta">
          <h3>Reserva la teva visita en línia</h3>
          <p>La sol·licitud es fa en una pàgina dedicada perquè puguis completar les teves dades sense distraccions.</p>
          <div class="contact__cta-actions">
            <a href={`${localeBase}reservar-cita`} class="btn btn--primary">Reservar visita</a>
            <a href="tel:877643360" class="btn btn--outline">Trucar ara</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
