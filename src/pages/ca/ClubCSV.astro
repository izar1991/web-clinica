---
import Layout from '../../layouts/Layout.astro';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;

const plans = [
  {
    name: 'Club CSV General',
    slug: 'general',
    badge: 'General',
    icon: '👤',
    featured: true,
    annual: '390 € / any',
    monthly: '35 € / mes',
    audience: 'Ideal per a adults i famílies que busquen atenció mèdica preventiva, continuïtat i serveis de salut integrals.',
    benefits: [
      'Medicina general: 12 visites / any', 'Visites posteriors: 25€', 'Infermeria: 12 visites / any (cures i injectables*)',
      'Analítica bàsica anual: hemograma, glucosa, colesterol total, colesterol HDL/LDL, triglicèrids, creatinina, transaminases TGO/TGP, urea, VSG',
      'Analítiques posteriors: 15% de descompte', 'Ginecologia: revisió anual (citologia + ecografia + visita)',
      'Fisioteràpia: 5 sessions (45\') / any', 'Sessions posteriors: 36€', 'Podologia: 1 quiropòdia / any', 'Quiropòdies posteriors: 25€',
      'Descomptes especials: especialitats 50€, psicologia 40€, proves diagnòstiques Eco/RX 20%, altres serveis 10%',
    ],
  },
  {
    name: 'Club CSV Sport',
    slug: 'sport',
    badge: 'Sport',
    icon: '⚡',
    featured: false,
    annual: '449 € / any',
    monthly: '40 € / mes',
    audience: 'Pensat per a persones actives i esportistes que volen rendiment, recuperació i atenció preventiva orientada al moviment.',
    benefits: [
      'Medicina general: 12 visites / any', 'Visites posteriors: 25€', 'Infermeria: 12 visites / any (cures i injectables*)',
      'Analítica esportiva anual: bàsica + gamma, fosfatasa, TSH/T3/T4, cortisol, vitamina D, creatina-cinasa, ferro, hemoglobina glicosilada',
      'Analítiques posteriors: 15% de descompte', 'Fisioteràpia: 10 sessions (30\') / any', 'Sessions posteriors: 30€',
      'Bono de 5 sessions (mensual): 135€', 'Sessió MEP-EPI: 40€', 'Podologia: 1 quiropòdia / any', 'Estudi biomecànic anual',
      'Quiropòdies posteriors: 25€', 'Preu especial plantilles: 160€', 'Descomptes especials: especialitats 50€, psicologia 40€, proves diagnòstiques Eco/RX 20%, altres serveis 10%',
    ],
  },
  {
    name: 'Club CSV Senior (+60)',
    slug: 'senior',
    badge: 'Senior',
    icon: '🌿',
    featured: false,
    annual: '390 € / any',
    monthly: '35 € / mes',
    audience: 'Dissenyat per a majors de 60 anys amb atenció preventiva, continuïtat i benestar integral per al dia a dia.',
    benefits: [
      'Medicina general: 12 visites / any', 'Visites posteriors: 25€', 'Infermeria: 12 visites / any (cures i injectables*)',
      'Analítica sènior anual: bàsica + vitamina D, PSA, filtrat glomerular, TSH/T3/T4', 'Analítiques posteriors: 15% de descompte',
      'Fisioteràpia: 5 sessions (45\') / any', 'Bono de 5 sessions (mensual): 180€', 'Podologia: 2 quiropòdies / any',
      'Quiropòdies posteriors: bono 3x2', 'Descomptes especials: especialitats 50€, psicologia 40€, proves diagnòstiques Eco/RX 20%, altres serveis 10%',
    ],
  },
];

const commonIncludes = [
  {
    concept: 'Medicina general',
    value: '12 visites / any',
  },
  {
    concept: 'Visites posteriors',
    value: '25€',
  },
  {
    concept: 'Infermeria',
    value: '12 visites / any (cures i injectables*)',
  },
  {
    concept: 'Analítiques posteriors',
    value: '15% de descompte',
  },
  {
    concept: 'Descomptes especials',
    value: 'Especialitats 50€ / Psicologia 40€ / Proves diagnòstiques Eco/RX 20% / Altres serveis 10%',
  },
];

const comparisonRows = [
  {
    concept: 'Preu',
    general: '390 € / any o 35 € / mes',
    sport: '449 € / any o 40 € / mes',
    senior: '390 € / any o 35 € / mes',
  },
  {
    concept: 'Analítica anual',
    general: 'Bàsica',
    sport: 'Esportiva',
    senior: 'Senior',
  },
  {
    concept: 'Fisioteràpia inclosa',
    general: '5 sessions (45\') / any',
    sport: '10 sessions (30\') / any',
    senior: '5 sessions (45\') / any',
  },
  {
    concept: 'Condicions extra de fisio',
    general: 'Sessions posteriors: 36€',
    sport: 'Sessions posteriors: 30€ / Bono de 5 sessions: 135€ / MEP-EPI: 40€',
    senior: 'Bono de 5 sessions (mensual): 180€',
  },
  {
    concept: 'Podologia inclosa',
    general: '1 quiropòdia / any',
    sport: '1 quiropòdia / any + estudi biomecànic anual',
    senior: '2 quiropòdies / any',
  },
  {
    concept: 'Podologia posterior',
    general: 'Quiropòdies posteriors: 25€',
    sport: 'Quiropòdies posteriors: 25€ / Plantilles: 160€',
    senior: 'Quiropòdies posteriors: bono 3x2',
  },
];

const isDifferentRow = (row: { general: string; sport: string; senior: string }) => {
  return new Set([row.general, row.sport, row.senior]).size > 1;
};

const isUniqueValueInRow = (row: { general: string; sport: string; senior: string }, value: string) => {
  if (!isDifferentRow(row)) return false;
  const values = [row.general, row.sport, row.senior];
  return values.filter((item) => item === value).length === 1;
};
---

<Layout
  title="Club CSV | Centre Sanitari Villaquet"
  description="Descobreix les targetes Club CSV de Centre Sanitari Villaquet: General, Sport i Sènior (+60), amb serveis mèdics, analítiques i descomptes."
  keywords="Club CSV Calafell, targeta CSV, medicina general Calafell, fisioteràpia Calafell, podologia Calafell, targeta sanitària"
>
  <main>
    <section class="club-page__hero">
      <div class="container club-page__hero-inner">
        <span class="section__tag">Club CSV</span>
        <h1 class="section__title">Una manera més fàcil de cuidar la teva salut</h1>
        <p class="section__desc">Tres modalitats pensades per acompanyar-te amb atenció preventiva, continuïtat mèdica i beneficis preferents.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="club-page__intro">
          <p>
            El Club CSV està pensat per facilitar l’accés a serveis mèdics de qualitat amb una estructura clara, flexible i orientada al benestar.
            La base és comuna: atenció mèdica, prevenció, diagnòstic i estalvi en serveis del centre, amb condicions específiques segons la targeta escollida.
          </p>
        </div>

        <div class="club-page__plans">
          {plans.map((plan) => (
            <article id={plan.slug} class={`club-page__plan ${plan.featured ? 'club-page__plan--featured' : ''}`}>
              <div class="club-page__head">
                <div class="club-page__icon" aria-hidden="true">{plan.icon}</div>
                <span class={`club-page__badge ${plan.slug === 'sport' ? 'club-page__badge--soft' : plan.slug === 'senior' ? 'club-page__badge--warm' : ''}`}>
                  {plan.badge}
                </span>
              </div>

              <h2>{plan.name}</h2>
              <p class="club-page__audience">{plan.audience}</p>

              <div class="club-page__pricing">
                <div class="club-page__price-block">
                  <span>Pagament anual</span>
                  <strong>{plan.annual}</strong>
                </div>
                <div class="club-page__price-block">
                  <span>Pagament mensual</span>
                  <strong>{plan.monthly}</strong>
                </div>
              </div>

              <ul class="club-page__list">
                {plan.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>

              <a href={`${localeBase}reservar-cita`} class="btn btn--primary btn--full">Sol·licitar informació</a>
            </article>
          ))}
        </div>
        <p class="club-page__legal-note">*Només ACTE MÈDIC - Injectable no inclòs.</p>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Inclòs en totes</span>
          <h2 class="section__title">El que tenen en comú les 3 targetes, en una sola taula</h2>
        </div>

        <div class="club-page__common-wrap">
          <table class="club-page__common" aria-label="Serveis comuns de les targetes Club CSV">
            <thead>
              <tr>
                <th scope="col">Inclou</th>
                <th scope="col">Cobertura comuna</th>
              </tr>
            </thead>
            <tbody>
              {commonIncludes.map((item) => (
                <tr>
                  <th scope="row">{item.concept}</th>
                  <td>{item.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Diferències clau</span>
          <h2 class="section__title">Què canvia entre General, Sport i Sènior</h2>
        </div>

        <p class="club-page__compare-legend">Aquí només es mostren els punts que no són iguals entre modalitats.</p>

        <div class="club-page__compare-wrap">
          <table class="club-page__compare" aria-label="Comparativa de tarjetas Club CSV">
            <thead>
              <tr>
                <th scope="col">Concepte</th>
                <th scope="col">General</th>
                <th scope="col">Sport</th>
                <th scope="col">Sènior (+60)</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class={isDifferentRow(row) ? 'club-page__compare-row--different' : 'club-page__compare-row--same'}>
                  <th scope="row">{row.concept}</th>
                  <td data-plan="General" class={isUniqueValueInRow(row, row.general) ? 'club-page__compare-cell--unique' : ''}>{row.general}</td>
                  <td data-plan="Sport" class={isUniqueValueInRow(row, row.sport) ? 'club-page__compare-cell--unique' : ''}>{row.sport}</td>
                  <td data-plan="Senior (+60)" class={isUniqueValueInRow(row, row.senior) ? 'club-page__compare-cell--unique' : ''}>{row.senior}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="club-page__cta">
          <div>
            <span class="section__tag">Club CSV</span>
            <h2 class="section__title">La teva salut, amb continuïtat i avantatges</h2>
          </div>
          <p>
            La base del Club CSV es manté oberta a la incorporació de noves modalitats i serveis en funció de les necessitats del centre i dels seus pacients.
          </p>
          <div class="club-page__cta-actions">
            <a href={`${localeBase}reservar-cita`} class="btn btn--primary">Reservar visita</a>
            <a href="tel:877643360" class="btn btn--outline">Trucar al centre</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
