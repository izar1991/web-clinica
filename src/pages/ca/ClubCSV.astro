---
import Layout from '../../layouts/Layout.astro';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}ca/`;

const plans = [
  {
    name: 'Club CSV General',
    slug: 'general',
    badge: 'General',
    icon: '👤',
    featured: true,
    annual: '390 € / año',
    monthly: '35 € / mes',
    audience: 'Ideal para adultos y familias que buscan atención médica preventiva, continuidad y servicios de salud integrales.',
    benefits: [
      'Medicina General: 12 visitas / año',
      'Visitas posteriores: 25€',
      'Enfermería: 12 visitas / año (Curas e Inyectables*)',
      'Analítica Básica Anual: Hemograma, Glucosa, Colesterol Total, Colesterol HDL/LDL, Triglicéridos, Creatinina, Transaminasas TGO/TGP, Urea, VSG',
      'Analíticas posteriores: 15% DTO',
      'Ginecología: Revisión Anual (Citología + Ecografía + Visita)',
      'Fisioterapia: 5 sesiones (45\') / año',
      'Sesiones posteriores: 36€',
      'Podología: 1 quiropedia / año',
      'Quiropedias posteriores: 25€',
      'Descuentos especiales: Especialidades 50€, Psicología 40€, Pruebas diagnósticas Eco/RX 20% DTO, Otros servicios 10% DTO',
    ],
  },
  {
    name: 'Club CSV Sport',
    slug: 'sport',
    badge: 'Sport',
    icon: '⚡',
    featured: false,
    annual: '449 € / año',
    monthly: '40 € / mes',
    audience: 'Pensado para personas activas y deportistas que quieren rendimiento, recuperación y atención preventiva orientada al movimiento.',
    benefits: [
      'Medicina General: 12 visitas / año',
      'Visitas posteriores: 25€',
      'Enfermería: 12 visitas / año (Curas e Inyectables*)',
      'Analítica Deportiva Anual: Básica + Gamma, Fosfatasa, TSH/T3/T4, Cortisol, Vitamina D, Creatina-Cinasa, Hierro, Hemoglobina Glicosilada',
      'Analíticas posteriores: 15% DTO',
      'Fisioterapia: 10 sesiones (30\') / año',
      'Sesiones posteriores: 30€',
      'Bono 5 sesiones (mensual): 135€',
      'Sesión MEP-EPI: 40€',
      'Podología: 1 quiropedia / año',
      'Estudio Biomecánico Anual',
      'Quiropedias posteriores: 25€',
      'Precio especial plantillas: 160€',
      'Descuentos especiales: Especialidades 50€, Psicología 40€, Pruebas diagnósticas Eco/RX 20% DTO, Otros servicios 10% DTO',
    ],
  },
  {
    name: 'Club CSV Senior (+60)',
    slug: 'senior',
    badge: 'Senior',
    icon: '🌿',
    featured: false,
    annual: '390 € / año',
    monthly: '35 € / mes',
    audience: 'Diseñado para mayores de 60 años con atención preventiva, continuidad y bienestar integral para el día a día.',
    benefits: [
      'Medicina General: 12 visitas / año',
      'Visitas posteriores: 25€',
      'Enfermería: 12 visitas / año (Curas e Inyectables*)',
      'Analítica Senior Anual: Básica + Vitamina D, PSA, Filtrado Glomerular, TSH/T3/T4',
      'Analíticas posteriores: 15% DTO',
      'Fisioterapia: 5 sesiones (45\') / año',
      'Bono 5 sesiones (mensual): 180€',
      'Podología: 2 quiropedias / año',
      'Quiropedias posteriores: Bono 3x2',
      'Descuentos especiales: Especialidades 50€, Psicología 40€, Pruebas diagnósticas Eco/RX 20% DTO, Otros servicios 10% DTO',
    ],
  },
];

const commonIncludes = [
  {
    concept: 'Medicina General',
    value: '12 visitas / año',
  },
  {
    concept: 'Visitas posteriores',
    value: '25€',
  },
  {
    concept: 'Enfermería',
    value: '12 visitas / año (Curas e Inyectables*)',
  },
  {
    concept: 'Analíticas posteriores',
    value: '15% DTO',
  },
  {
    concept: 'Descuentos especiales',
    value: 'Especialidades 50€ / Psicología 40€ / Pruebas diagnósticas Eco/RX 20% DTO / Otros servicios 10% DTO',
  },
];

const comparisonRows = [
  {
    concept: 'Precio',
    general: '390 € / año o 35 € / mes',
    sport: '449 € / año o 40 € / mes',
    senior: '390 € / año o 35 € / mes',
  },
  {
    concept: 'Analítica anual',
    general: 'Básica',
    sport: 'Deportiva',
    senior: 'Senior',
  },
  {
    concept: 'Fisioterapia incluida',
    general: '5 sesiones (45\') / año',
    sport: '10 sesiones (30\') / año',
    senior: '5 sesiones (45\') / año',
  },
  {
    concept: 'Condiciones extra fisio',
    general: 'Sesiones posteriores: 36€',
    sport: 'Sesiones posteriores: 30€ / Bono 5 sesiones: 135€ / MEP-EPI: 40€',
    senior: 'Bono 5 sesiones (mensual): 180€',
  },
  {
    concept: 'Podología incluida',
    general: '1 quiropedia / año',
    sport: '1 quiropedia / año + Estudio biomecánico anual',
    senior: '2 quiropedias / año',
  },
  {
    concept: 'Podología posterior',
    general: 'Quiropedias posteriores: 25€',
    sport: 'Quiropedias posteriores: 25€ / Plantillas: 160€',
    senior: 'Quiropedias posteriores: Bono 3x2',
  },
];

const isDifferentRow = (row: { general: string; sport: string; senior: string }) => {
  return new Set([row.general, row.sport, row.senior]).size > 1;
};

const isUniqueValueInRow = (row: { general: string; sport: string; senior: string }, value: string) => {
  if (!isDifferentRow(row)) return false;
  const values = [row.general, row.sport, row.senior];
  return values.filter((item) => item === value).length === 1;
};
---

<Layout
  title="Club CSV | Centre Sanitari Villaquet"
  description="Descubre las tarjetas Club CSV de Centre Sanitari Villaquet: General, Sport y Senior (+60) con servicios médicos, analítica y descuentos."
  keywords="Club CSV Calafell, tarjeta CSV, medicina general Calafell, fisioterapia Calafell, podología Calafell, tarjeta sanitaria"
>
  <main>
    <section class="club-page__hero">
      <div class="container club-page__hero-inner">
        <span class="section__tag">Club CSV</span>
        <h1 class="section__title">Una forma más fácil de cuidar tu salud</h1>
        <p class="section__desc">Tres modalidades pensadas para acompañarte con atención preventiva, continuidad médica y beneficios preferentes.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="club-page__intro">
          <p>
            El Club CSV está pensado para facilitar el acceso a servicios médicos de calidad con una estructura clara, flexible y orientada al bienestar.
            La base es común: atención médica, prevención, diagnóstico y ahorro en servicios del centro, con condiciones específicas según la tarjeta elegida.
          </p>
        </div>

        <div class="club-page__plans">
          {plans.map((plan) => (
            <article id={plan.slug} class={`club-page__plan ${plan.featured ? 'club-page__plan--featured' : ''}`}>
              <div class="club-page__head">
                <div class="club-page__icon" aria-hidden="true">{plan.icon}</div>
                <span class={`club-page__badge ${plan.slug === 'sport' ? 'club-page__badge--soft' : plan.slug === 'senior' ? 'club-page__badge--warm' : ''}`}>
                  {plan.badge}
                </span>
              </div>

              <h2>{plan.name}</h2>
              <p class="club-page__audience">{plan.audience}</p>

              <div class="club-page__pricing">
                <div class="club-page__price-block">
                  <span>Pago anual</span>
                  <strong>{plan.annual}</strong>
                </div>
                <div class="club-page__price-block">
                  <span>Pago mensual</span>
                  <strong>{plan.monthly}</strong>
                </div>
              </div>

              <ul class="club-page__list">
                {plan.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>

              <a href={`${localeBase}reservar-cita`} class="btn btn--primary btn--full">Solicitar información</a>
            </article>
          ))}
        </div>
        <p class="club-page__legal-note">*Sólo ACTO MÉDICO - Inyectable no incluido.</p>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Incluye en todas</span>
          <h2 class="section__title">Lo común de las 3 tarjetas, en una sola tabla</h2>
        </div>

        <div class="club-page__common-wrap">
          <table class="club-page__common" aria-label="Servicios comunes de las tarjetas Club CSV">
            <thead>
              <tr>
                <th scope="col">Incluye</th>
                <th scope="col">Cobertura común</th>
              </tr>
            </thead>
            <tbody>
              {commonIncludes.map((item) => (
                <tr>
                  <th scope="row">{item.concept}</th>
                  <td>{item.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Diferencias clave</span>
          <h2 class="section__title">Qué cambia entre General, Sport y Senior</h2>
        </div>

        <p class="club-page__compare-legend">Aquí solo se muestran los puntos que no son iguales entre modalidades.</p>

        <div class="club-page__compare-wrap">
          <table class="club-page__compare" aria-label="Comparativa de tarjetas Club CSV">
            <thead>
              <tr>
                <th scope="col">Concepto</th>
                <th scope="col">General</th>
                <th scope="col">Sport</th>
                <th scope="col">Senior (+60)</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class={isDifferentRow(row) ? 'club-page__compare-row--different' : 'club-page__compare-row--same'}>
                  <th scope="row">{row.concept}</th>
                  <td data-plan="General" class={isUniqueValueInRow(row, row.general) ? 'club-page__compare-cell--unique' : ''}>{row.general}</td>
                  <td data-plan="Sport" class={isUniqueValueInRow(row, row.sport) ? 'club-page__compare-cell--unique' : ''}>{row.sport}</td>
                  <td data-plan="Senior (+60)" class={isUniqueValueInRow(row, row.senior) ? 'club-page__compare-cell--unique' : ''}>{row.senior}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="club-page__cta">
          <div>
            <span class="section__tag">Club CSV</span>
            <h2 class="section__title">Tu salud, con continuidad y ventajas</h2>
          </div>
          <p>
            La base de Club CSV se mantiene abierta a la incorporación de nuevas modalidades y servicios en función de las necesidades del centro y de sus pacientes.
          </p>
          <div class="club-page__cta-actions">
            <a href={`${localeBase}reservar-cita`} class="btn btn--primary">Reservar cita</a>
            <a href="tel:877643360" class="btn btn--outline">Llamar al centro</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
