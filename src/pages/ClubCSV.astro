---
import Layout from '../layouts/Layout.astro';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const plans = [
  {
    name: 'Club CSV General',
    slug: 'general',
    badge: 'General',
    icon: '👤',
    featured: true,
    annual: '390 € / año',
    monthly: '35 € / mes',
    audience: 'Ideal para adultos y familias que buscan atención médica preventiva, continuidad y servicios de salud integrales.',
    benefits: [
      'Medicina General: 12 visitas al año',
      'Visitas posteriores: 25€ por visita',
      'Enfermería: 12 visitas al año (curas e inyectables*)',
      'Analítica Básica anual incluida: hemograma, glucosa, colesterol total, HDL/LDL, triglicéridos, creatinina, TGO/TGP, urea y VSG',
      'Analíticas posteriores: 15% de descuento',
      'Ginecología: revisión anual con citología + ecografía + visita',
      'Fisioterapia: 5 sesiones de 45 minutos al año',
      'Sesiones posteriores: 36€ por sesión',
      'Podología: 1 quiropedia al año',
      'Quiropedias posteriores: 25€',
      'Descuentos especiales: 50% en especialidades, 40% en Psicología, 20% en pruebas diagnósticas Eco/RX y 10% en otros servicios',
    ],
  },
  {
    name: 'Club CSV Sport',
    slug: 'sport',
    badge: 'Sport',
    icon: '⚡',
    featured: false,
    annual: '449 € / año',
    monthly: '40 € / mes',
    audience: 'Pensado para personas activas y deportistas que quieren rendimiento, recuperación y atención preventiva orientada al movimiento.',
    benefits: [
      'Medicina General: 12 visitas al año',
      'Visitas posteriores: 25€ por visita',
      'Enfermería: 12 visitas al año (curas e inyectables*)',
      'Analítica Deportiva anual incluida: básica + gamma, fosfatasa, TSH/T3/T4, cortisol, vitamina D, creatina-cinasa, hierro y hemoglobina glicosilada',
      'Analíticas posteriores: 15% de descuento',
      'Fisioterapia: 10 sesiones de 30 minutos al año',
      'Sesiones posteriores: 30€ por sesión',
      'Bono de 5 sesiones mensuales: 135€',
      'Sesión MEP-EPI: 40€',
      'Podología: 1 quiropedia al año + estudio biomecánico anual',
      'Quiropedias posteriores: 25€',
      'Plantillas: precio especial 160€',
      'Descuentos especiales: 50% en especialidades, 40% en Psicología, 20% en pruebas diagnósticas Eco/RX y 10% en otros servicios',
    ],
  },
  {
    name: 'Club CSV Senior (+60)',
    slug: 'senior',
    badge: 'Senior',
    icon: '🌿',
    featured: false,
    annual: '390 € / año',
    monthly: '35 € / mes',
    audience: 'Diseñado para mayores de 60 años con atención preventiva, continuidad y bienestar integral para el día a día.',
    benefits: [
      'Medicina General: 12 visitas al año',
      'Visitas posteriores: 25€ por visita',
      'Enfermería: 12 visitas al año (curas e inyectables*)',
      'Analítica Senior anual incluida: básica + vitamina D, PSA, filtrado glomerular y TSH/T3/T4',
      'Analíticas posteriores: 15% de descuento',
      'Fisioterapia: 5 sesiones de 45 minutos al año',
      'Bono de 5 sesiones mensuales: 180€',
      'Podología: 2 quiropedias al año',
      'Quiropedias posteriores: bono 3x2',
      'Descuentos especiales: 50% en especialidades, 40% en Psicología, 20% en pruebas diagnósticas Eco/RX y 10% en otros servicios',
    ],
  },
];

const includedServices = [
  {
    title: 'Atención médica continua',
    text: 'Consulta de medicina general y enfermería para seguimiento, prevención y control de la salud en cualquier etapa.',
  },
  {
    title: 'Descuentos especiales',
    text: 'Acceso a precios preferentes en especialidades, pruebas diagnósticas y servicios complementarios del centro.',
  },
  {
    title: 'Fisioterapia y podología',
    text: 'Sesiones periódicas y revisiones específicas para mejorar movilidad, rehabilitación, confort y calidad de vida.',
  },
  {
    title: 'Adaptado para cada etapa',
    text: 'Tres modalidades pensadas para adultos, deportistas y mayores, con una base sólida y condiciones claramente diferenciadas en el Anexo I.',
  },
];
---

<Layout
  title="Club CSV | Centre Sanitari Villaquet"
  description="Descubre las tarjetas Club CSV de Centre Sanitari Villaquet: General, Sport y Senior (+60) con servicios médicos, analítica y descuentos."
  keywords="Club CSV Calafell, tarjeta CSV, medicina general Calafell, fisioterapia Calafell, podología Calafell, tarjeta sanitaria"
>
  <main>
    <section class="club-page__hero">
      <div class="container club-page__hero-inner">
        <span class="section__tag">Club CSV</span>
        <h1 class="section__title">Una forma más fácil de cuidar tu salud</h1>
        <p class="section__desc">Tres modalidades pensadas para acompañarte con atención preventiva, continuidad médica y beneficios preferentes.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="club-page__intro">
          <p>
            El Club CSV está pensado para facilitar el acceso a servicios médicos de calidad con una estructura clara, flexible y orientada al bienestar.
            La base es común: atención médica, prevención, diagnóstico y ahorro en servicios del centro, con condiciones específicas según la tarjeta elegida.
          </p>
        </div>

        <div class="club-page__plans">
          {plans.map((plan) => (
            <article class={`club-page__plan ${plan.featured ? 'club-page__plan--featured' : ''}`}>
              <div class="club-page__head">
                <div class="club-page__icon" aria-hidden="true">{plan.icon}</div>
                <span class={`club-page__badge ${plan.slug === 'sport' ? 'club-page__badge--soft' : plan.slug === 'senior' ? 'club-page__badge--warm' : ''}`}>
                  {plan.badge}
                </span>
              </div>

              <h2>{plan.name}</h2>
              <p class="club-page__audience">{plan.audience}</p>

              <div class="club-page__pricing">
                <div class="club-page__price-block">
                  <span>Pago anual</span>
                  <strong>{plan.annual}</strong>
                </div>
                <div class="club-page__price-block">
                  <span>Pago mensual</span>
                  <strong>{plan.monthly}</strong>
                </div>
              </div>

              <ul class="club-page__list">
                {plan.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>

              <a href={`${base}reservar-cita`} class="btn btn--primary btn--full">Solicitar información</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <span class="section__tag">Qué incluye</span>
          <h2 class="section__title">Una propuesta de salud integral y adaptable</h2>
        </div>

        <div class="club-page__features">
          {includedServices.map((service) => (
            <article class="club-page__feature">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="club-page__cta">
          <div>
            <span class="section__tag">Club CSV</span>
            <h2 class="section__title">Tu salud, con continuidad y ventajas</h2>
          </div>
          <p>
            La base de Club CSV se mantiene abierta a la incorporación de nuevas modalidades y servicios en función de las necesidades del centro y de sus pacientes.
          </p>
          <div class="club-page__cta-actions">
            <a href={`${base}reservar-cita`} class="btn btn--primary">Reservar cita</a>
            <a href="tel:877643360" class="btn btn--outline">Llamar al centro</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
