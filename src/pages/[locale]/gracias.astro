---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  const locales = ['en-GB', 'de-DE', 'fr-FR', 'zh-CN', 'ar'];
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const messages = {
  'en-GB': {
    badge: 'Thank you',
    title: 'Your appointment request has been sent',
    text: 'Thank you for trusting Centre Sanitari Villaquet. You will receive a message with your appointment details by email.',
    home: 'Back to home',
    bookAgain: 'Book another appointment',
    help: 'Phone',
    email: 'Email',
    portalTitle: 'Manage your care from the patient portal',
    portalText: 'Access your appointments, email communications, personal details, reports and available medical tests whenever you need them.',
    portalCta: 'Access the patient portal',
    careMessage: 'Looking after your health starts with this step.',
    portalLabel: 'Your healthcare space',
    locationLabel: 'Visit us',
    homeLabel: 'Back to home',
    cancellation: 'Important: appointments must be cancelled or changed at least 48 hours in advance.',
  },
  'de-DE': {
    badge: 'Vielen Dank',
    title: 'Ihre Terminanfrage wurde gesendet',
    text: 'Vielen Dank für Ihr Vertrauen in Centre Sanitari Villaquet. Sie erhalten Ihre Termindetails per E-Mail.',
    home: 'Zur Startseite',
    bookAgain: 'Weiteren Termin buchen',
    help: 'Telefon',
    email: 'E-Mail',
    portalTitle: 'Verwalten Sie Ihre Betreuung im Patientenportal',
    portalText: 'Rufen Sie Ihre Termine, E-Mail-Kommunikation, persönlichen Daten, Berichte und verfügbaren medizinischen Untersuchungen jederzeit ab.',
    portalCta: 'Patientenportal öffnen',
    careMessage: 'Für Ihre Gesundheit zu sorgen beginnt mit diesem Schritt.',
    portalLabel: 'Ihr Gesundheitsbereich',
    locationLabel: 'Besuchen Sie uns',
    homeLabel: 'Zur Startseite',
    cancellation: 'Wichtig: Termine müssen mindestens 48 Stunden im Voraus abgesagt oder geändert werden.',
  },
  'fr-FR': {
    badge: 'Merci',
    title: 'Votre demande de rendez-vous a bien été envoyée',
    text: 'Merci de faire confiance à Centre Sanitari Villaquet. Vous recevrez les détails de votre rendez-vous par e-mail.',
    home: 'Retour à l’accueil',
    bookAgain: 'Prendre un autre rendez-vous',
    help: 'Téléphone',
    email: 'E-mail',
    portalTitle: 'Gérez votre suivi depuis le portail patient',
    portalText: 'Consultez vos rendez-vous, communications par e-mail, données personnelles, comptes rendus et examens médicaux disponibles à tout moment.',
    portalCta: 'Accéder au portail patient',
    careMessage: 'Prendre soin de votre santé commence par cette étape.',
    portalLabel: 'Votre espace santé',
    locationLabel: 'Nous trouver',
    homeLabel: 'Retour à l’accueil',
    cancellation: 'Important : toute annulation ou modification doit être effectuée au moins 48 heures à l’avance.',
  },
  'zh-CN': {
    badge: '感谢',
    title: '您的预约申请已发送',
    text: '感谢您信任 Centre Sanitari Villaquet。预约详情将发送至您的电子邮箱。',
    home: '返回首页',
    bookAgain: '再次预约',
    help: '电话',
    email: '邮箱',
    portalTitle: '通过患者门户管理您的医疗服务',
    portalText: '您可以随时查看预约、电子邮件通信、个人资料、报告和可用的医疗检查结果。',
    portalCta: '进入患者门户',
    careMessage: '关爱健康，就从这一步开始。',
    portalLabel: '您的健康空间',
    locationLabel: '欢迎到访',
    homeLabel: '返回首页',
    cancellation: '重要提示：如需取消或更改预约，请至少提前48小时通知我们。',
  },
  ar: {
    badge: 'شكرًا لك',
    title: 'تم إرسال طلب موعدك',
    text: 'شكرًا لثقتك بمركز Centre Sanitari Villaquet. ستتلقى تفاصيل موعدك عبر البريد الإلكتروني.',
    home: 'العودة إلى الرئيسية',
    bookAgain: 'حجز موعد آخر',
    help: 'الهاتف',
    email: 'البريد الإلكتروني',
    portalTitle: 'إدارة رعايتك من خلال بوابة المريض',
    portalText: 'يمكنك الوصول في أي وقت إلى مواعيدك ورسائل البريد الإلكتروني وبياناتك الشخصية وتقاريرك والفحوصات الطبية المتاحة.',
    portalCta: 'الدخول إلى بوابة المريض',
    careMessage: 'العناية بصحتك تبدأ بهذه الخطوة.',
    portalLabel: 'مساحتك الصحية',
    locationLabel: 'موقعنا',
    homeLabel: 'العودة إلى الرئيسية',
    cancellation: 'مهم: يجب إلغاء المواعيد أو تعديلها قبل 48 ساعة على الأقل.',
  },
};

const content = messages[locale] || messages['en-GB'];
const base = `/${locale}/`;
const patientPortalUrl = 'https://portalpaciente.dricloud.net/Dricloud_centresanitarivillaquet_21026811';
---

<Layout title={content.title} description={content.text}>
  <main>
    <section class="section thanks-page">
      <div class="container thanks-page__content">
        <a class="thanks-page__brand nav__logo nav__logo--brand" href={base} aria-label={content.home}>
          <img src="/images/logo_solo.png" alt="Centre Sanitari Villaquet" width="54" height="54" class="nav__logo-image nav__logo-image--solo" />
          <span class="nav__brand-text" aria-label="Centre Sanitari Villaquet">
            <span class="nav__brand-text--top">Centre Sanitari</span>
            <span class="nav__brand-text--bottom">Villaquet</span>
          </span>
        </a>
        <span class="section__tag">{content.badge}</span>
        <p class="thanks-page__wellness">{content.careMessage}</p>
        <p class="section__desc">{content.text}</p>

        <div class="thanks-page__lower">
          <div class="thanks-page__main">
            <div class="thanks-page__location">
              <div>
                <span class="thanks-page__location-label">{content.locationLabel}</span>
                <h2>Centre Sanitari Villaquet</h2>
                <address>Carrer Molí del Blanquet, 24, baixos<br />El Vilarenc, 43820 Calafell, Tarragona</address>
              </div>
              <iframe title="Centre Sanitari Villaquet" src="https://maps.google.com/maps?q=Carrer+Mol%C3%AD+del+Blanquet+24+Calafell&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            </div>

            <div class="thanks-page__actions">
              <a href={base} class="btn btn--primary">{content.home}</a>
              <a href={`${base}reservar-cita`} class="btn btn--outline">{content.bookAgain}</a>
            </div>

            <div class="thanks-page__info">
              <p><strong>{content.help}:</strong> 877643360</p>
              <p><strong>{content.email}:</strong> info@villaquet.com</p>
              <p class="thanks-page__policy">{content.cancellation}</p>
            </div>
          </div>

          <div class="thanks-page__portal thanks-page__portal--distinct">
            <span class="thanks-page__portal-icon" aria-hidden="true">&#128274;</span>
            <div>
              <span class="thanks-page__portal-label">{content.portalLabel}</span>
              <h2>{content.portalTitle}</h2>
              <p>{content.portalText}</p>
              <a href={patientPortalUrl} class="btn btn--portal" target="_blank" rel="noopener">{content.portalCta}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
