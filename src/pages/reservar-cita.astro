---
import Layout from '../layouts/Layout.astro';

const iframeSrc = 'https://citaonline.dricloud.net/?URL=dricloud_centresanitarivillaquet_21026811';
---

<Layout title="Reservar cita | Centre Sanitari Villaquet" description="Reserva tu cita en Centre Sanitari Villaquet. Solicita una consulta médica en Calafell y contactaremos contigo lo antes posible.">
  <main>
    <section class="reservation-page__hero">
      <div class="container reservation-page__intro">
        <span class="section__tag">Reserva tu cita</span>
        <h1 class="section__title">Solicita una consulta con nosotros</h1>
        <p class="section__desc">Rellena el formulario y te contactaremos para confirmar la cita o indicarte el siguiente paso según la especialidad que necesites.</p>
      </div>
    </section>

    <section class="container reservation-page__grid">
      <div class="reservation-page__notice" aria-label="Información de reserva">
        <p><strong>¿Cómo funciona?</strong> Selecciona la especialidad y la fecha disponible, confirma la solicitud desde el módulo online y recibirás la validación de tu cita en el horario indicado.</p>
      </div>

      <div class="reservation-widget">
        <div class="reservation-widget__header">
          <span class="section__tag">Cita online</span>
          <h2>Reserva tu visita con nuestro sistema</h2>
        </div>

        <div class="reservation-widget__wrapper">
          <iframe
            id="ifrModuloCitaonlineVisualizacion"
            title="Reserva online Centre Sanitari Villaquet"
            src={iframeSrc}
            frameborder="0"
            scrolling="auto"
            width="100%"
            height="600"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="reservation-page__help">
        <h3>¿Necesitas ayuda?</h3>
        <p>Puedes hablar con nosotros directamente para resolver dudas sobre horarios, servicios, seguros o cobertura.</p>
        <div class="reservation-page__actions">
          <a href="tel:877643360" class="btn btn--primary">877 643 360</a>
          <a href="mailto:info@villaquet.com" class="btn btn--outline">info@villaquet.com</a>
        </div>
      </div>
    </section>

    <script is:inline>
      window.addEventListener('message', function (event) {
        if (event.origin !== 'https://citaonline.dricloud.net') return;

        const iframe = document.getElementById('ifrModuloCitaonlineVisualizacion');
        if (!iframe) return;

        const heightIframe = Number(event.data) || 300;
        iframe.height = String(heightIframe);
      });
    </script>
  </main>
</Layout>
