---
import Layout from '../layouts/Layout.astro';
import { especialidades } from '../data/especialidades';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<Layout
  title="Servicios médicos en Calafell | Centre Sanitari Villaquet"
  description="Descubre la cartera de servicios médicos en Calafell: medicina general, ginecología, dermatología, psicología, fisioterapia, podología y diagnóstico por imagen."
  keywords="servicios médicos Calafell, centro médico Calafell, medicina general Calafell, ginecología Calafell, dermatología Calafell, fisioterapia Calafell, podología Calafell"
>
  <main>
    <section class="specialties-page__hero">
      <div class="container">
        <span class="section__tag">Especialidades</span>
        <h1 class="section__title">Servicios médicos para todas tus necesidades</h1>
        <p class="section__desc">Consulta nuestra cartera de especialidades y encuentra la atención más adecuada para ti y tu familia.</p>
      </div>
    </section>

    <section class="section">
      <div class="container specialties-page__grid">
        {especialidades.map((especialidad) => (
          <article class="specialty-page-card">
            <div class="specialty-page-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v18M3 12h18"/><path d="M7 5h10M7 19h10"/></svg>
            </div>
            <h2>{especialidad.title}</h2>
            <p>Atención especializada, cercana y centrada en tu bienestar.</p>
            <a href={`${base}servicios/${especialidad.slug}`} class="btn btn--outline">Ver más</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--alt" aria-labelledby="seo-servicios-title">
      <div class="container">
        <h2 id="seo-servicios-title" class="section__title">Especialidades médicas en Calafell con atención integral</h2>
        <p class="section__desc">Nuestro equipo ofrece un enfoque multidisciplinar para resolver necesidades de prevención, diagnóstico y tratamiento en cada etapa de la salud.</p>

        <div class="why__grid" style="margin-top: 1.5rem;">
          <article class="why-card">
            <h3>Diagnóstico rápido y preciso</h3>
            <p>Combinamos consulta clínica y pruebas diagnósticas para valorar cada caso con mayor seguridad y reducir tiempos de espera.</p>
          </article>
          <article class="why-card">
            <h3>Seguimiento coordinado entre especialidades</h3>
            <p>Los profesionales trabajan de forma conjunta para que cada paciente tenga continuidad asistencial y un plan de cuidado personalizado.</p>
          </article>
          <article class="why-card">
            <h3>Centro médico de proximidad en Calafell</h3>
            <p>Atención cercana para adultos, familias y personas mayores con procesos sencillos de cita y acompañamiento continuado.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>
