---
import Layout from '../layouts/Layout.astro';
import { profesionales } from '../data/especialidades';
import { getLocaleContent, getServiceContent } from '../i18n/localized';

const { locale, page, slug } = Astro.props;
const content = getLocaleContent(locale);
type ServiceItem = { slug: string; title: string; description: string };
const serviceList = content.serviceList as ServiceItem[];
const service = slug ? getServiceContent(locale, slug) : null;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const localeBase = `${base}${locale}/`;
const pageTitle = service ? `${service.title} | Centre Sanitari Villaquet` : `${content[page === 'home' ? 'home' : page]} | Centre Sanitari Villaquet`;
---

<Layout title={pageTitle} description={service?.intro || `${content.services} | Centre Sanitari Villaquet`}>
  <main>
    {page === 'home' && (
      <>
        <section class="hero" id="inicio">
          <div class="hero__bg"></div>
          <div class="container hero__grid">
            <div class="hero__content">
              <div class="hero__content-panel">
                <p class="hero__tag">Centre Sanitari Villaquet · Calafell</p>
                <h1 class="hero__title">{locale === 'zh-CN' ? '您在加拉费尔值得信赖的医疗中心' : locale === 'ar' ? 'مركزك الصحي الموثوق في كالافيل' : locale === 'de-DE' ? 'Ihr vertrauenswürdiges Zentrum in Calafell' : locale === 'fr-FR' ? 'Votre centre de confiance à Calafell' : locale === 'en-GB' ? 'Your trusted centre in Calafell' : 'Tu centro de confianza en Calafell'}</h1>
                <p class="hero__subtitle">{locale === 'zh-CN' ? '卓越而亲近的医疗服务，结合经验丰富的专业团队、先进技术和个性化护理。' : locale === 'ar' ? 'رعاية طبية متميزة وقريبة تجمع بين الخبرة والتقنية المتقدمة والعناية الشخصية.' : locale === 'de-DE' ? 'Medizinische Versorgung mit Erfahrung, moderner Technologie und persönlicher Betreuung.' : locale === 'fr-FR' ? 'Une médecine d’excellence et de proximité, avec une équipe expérimentée et une attention personnalisée.' : locale === 'en-GB' ? 'A centre of excellence and personal care, with experienced professionals and advanced technology.' : 'Un centro médico de excelencia y proximidad, con profesionales experimentados y atención personalizada.'}</p>
                <div class="hero__cta-group">
                  <a href={`${localeBase}reservar-cita`} class="btn btn--primary">{content.book}</a>
                </div>
                <div class="hero__stats" aria-label={content.home}>
                  <div class="hero__stat"><strong>8:00–20:00</strong><span>{locale === 'zh-CN' ? '服务时间' : locale === 'ar' ? 'ساعات العمل' : locale === 'de-DE' ? 'Öffnungszeiten' : locale === 'fr-FR' ? 'Horaires' : locale === 'en-GB' ? 'Opening hours' : 'Horario de atención'}</span></div>
                  <div class="hero__stat"><strong>+8</strong><span>{locale === 'zh-CN' ? '专科服务' : locale === 'ar' ? 'تخصصات' : locale === 'de-DE' ? 'Fachbereiche' : locale === 'fr-FR' ? 'Spécialités' : locale === 'en-GB' ? 'Specialties' : 'Especialidades'}</span></div>
                  <div class="hero__stat"><strong>Calafell</strong><span>{locale === 'zh-CN' ? '本地医疗中心' : locale === 'ar' ? 'مركز طبي محلي' : locale === 'de-DE' ? 'Lokales Zentrum' : locale === 'fr-FR' ? 'Centre local' : locale === 'en-GB' ? 'Local centre' : 'Centro médico local'}</span></div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <section class="services section" id="servicios">
          <div class="container">
            <div class="section__header"><span class="section__tag">{content.services}</span><h2 class="section__title">{content.viewAll}</h2></div>
            <div class="services__grid">
              {serviceList.map((item) => <a href={`${localeBase}servicios/${item.slug}`} class="service-card service-card--link"><h3>{item.title}</h3><p>{item.description}</p></a>)}
            </div>
          </div>
        </section>
        <section class="contact section" id="contacto">
          <div class="container contact__cta"><span class="section__tag">{content.contact}</span><h2 class="section__title">{content.appointment}</h2><p>{content.appointmentText}</p><a href={`${localeBase}reservar-cita`} class="btn btn--primary">{content.book}</a></div>
        </section>
      </>
    )}

    {page === 'services' && (
      <>
        <section class="specialties-page__hero"><div class="container"><span class="section__tag">{content.services}</span><h1 class="section__title">{content.viewAll}</h1><p class="section__desc">{content.appointmentText}</p></div></section>
        <section class="section"><div class="container specialties-page__grid">{serviceList.map((item) => <article class="specialty-page-card"><h2>{item.title}</h2><p>{item.description}</p><a href={`${localeBase}servicios/${item.slug}`} class="btn btn--outline">{content.viewAll}</a></article>)}</div></section>
      </>
    )}

    {page === 'team' && (
      <>
        <section class="specialties-page__hero"><div class="container"><span class="section__tag">{content.team}</span><h1 class="section__title">{content.teamTitle}</h1><p class="section__desc">{content.appointmentText}</p></div></section>
        <section class="team section"><div class="container"><div class="team__grid">{profesionales.map((professional) => <article class="doctor-card"><div class="doctor-card__header"><div class="doctor-card__avatar"><img src={professional.image} alt={professional.nombre} /></div><div><h3>{professional.nombre}</h3><p class="doctor-card__role">{serviceList.find((item) => item.slug === professional.especialidad)?.title}</p></div></div></article>)}</div></div></section>
      </>
    )}

    {page === 'club' && (
      <>
        <section class="club-page__hero"><div class="container club-page__hero-inner"><span class="section__tag">{content.club}</span><h1 class="section__title">{content.clubTitle}</h1><p class="section__desc">{content.appointmentText}</p></div></section>
        <section class="section section--dark"><div class="container club__wrapper"><div class="club__plans">{['General', 'Sport', 'Senior (+60)'].map((plan, index) => <article class={`club__plan ${index === 0 ? 'club__plan--featured' : ''}`}><span class="club__plan-badge">{plan}</span><h3>{content.club} {plan}</h3><p class="club__plan-audience">{content.appointmentText}</p><a href={`${localeBase}reservar-cita`} class="btn btn--light">{content.book}</a></article>)}</div></div></section>
      </>
    )}

    {page === 'appointment' && (
      <>
        <section class="reservation-page__hero"><div class="container reservation-page__intro"><span class="section__tag">{content.book}</span><h1 class="section__title">{content.appointment}</h1><p class="section__desc">{content.appointmentText}</p></div></section>
        <section class="container reservation-page__grid"><div class="reservation-widget"><div class="reservation-widget__header"><span class="section__tag">{content.book}</span><h2>{content.appointment}</h2></div><div class="reservation-widget__wrapper"><iframe title={`${content.book} Centre Sanitari Villaquet`} src="https://citaonline.dricloud.net/?URL=dricloud_centresanitarivillaquet_21026811" width="100%" height="600" loading="lazy"></iframe></div></div><div class="reservation-page__help"><h3>{content.contact}</h3><p>{content.appointmentText}</p><a href="tel:877643360" class="btn btn--primary">877 643 360</a></div></section>
      </>
    )}

    {page === 'service' && service && (
      <>
        <section class="specialty-page__hero"><div class="container"><span class="section__tag">{content.services}</span><h1 class="section__title">{service.title}</h1><p class="section__subtitle">{service.subtitle}</p></div></section>
        <section class="section"><div class="container specialty-page__grid"><div class="specialty-page__content"><p>{service.intro}</p><div class="specialty-page__media"><img src="/web-clinica/images/about.jpg" alt={service.title} /></div><div class="specialty-page__actions"><a href={`${localeBase}servicios`} class="btn btn--outline">{content.viewAll}</a></div></div><aside class="specialty-page__card"><h3>{content.appointment}</h3><p>{content.appointmentText}</p><a href={`${localeBase}reservar-cita`} class="btn btn--primary btn--full">{content.book}</a></aside></div></section>
      </>
    )}
  </main>
</Layout>
